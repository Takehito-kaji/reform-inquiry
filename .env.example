# このファイルをコピーして「.env」という名前で保存し、中身を書き換えてください
#   cp .env.example .env
# ※ .env は手元のパソコン用です。Render では「Environment」の画面で設定します

# --- MySQL（Sequel Ace で接続しているのと同じ情報） ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=

# --- Slack の Webhook URL（他の人に見せないでください） ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# --- PDFも Slack に送る場合（任意。2つとも書くとボットで送ります） ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- 受付アプリのアドレス（任意。Slack に「受付アプリで開く」リンクが付きます） ---
# Render では自動で設定されるので不要です
APP_BASE_URL=

# --- Basic認証（任意。手元では空欄のままでOK。Render では必須） ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
